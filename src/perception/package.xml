  <version>0.0.0</version>
  <description>Lane detection and stage sign recognition</description>
  <maintainer email="ario@todo.todo">ario</maintainer>
  <license>MIT</license>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
